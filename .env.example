# CareCard Environment Variables
# Copy this file to .env and fill in your Supabase credentials.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set VITE_DEMO_MODE=true to enable local mock storage if Supabase credentials are not configured.
# Set to false or leave empty for secure production deployments.
VITE_DEMO_MODE=

# NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code.
# Service role keys belong only in server-side Edge Functions.
